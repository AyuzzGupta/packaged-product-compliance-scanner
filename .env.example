# =================================================================
# Packaged Product Compliance Scanner (SIH26034)
# Environment Configuration Template
# =================================================================

# Server port for Express backend (Use 5001 on macOS as 5000 is occupied by AirPlay)
PORT=5001

# Runtime environment (development / production / test)
NODE_ENV=development

# Full URL endpoint of the Python FastAPI ML Microservice
ML_SERVICE_URL=http://localhost:8001

# Maximum request timeout for ML microservice calls in milliseconds
ML_TIMEOUT_MS=4000

# Maximum single image upload size allowed in Megabytes
MAX_UPLOAD_MB=8

# Maximum number of label images allowed in batch retailer scan mode
MAX_BATCH_FILES=10

# Relative or absolute file path to persistent JSON scan records
DATA_FILE=data/scans.json

# Path to Tesseract OCR neural network traineddata model directory
TESSDATA_PATH=backend/assets/tessdata

# Port on which the Python FastAPI ML microservice binds
ML_PORT=8001
